# The build context is the single biggest lever on Docker build time. Without
# this file the daemon copies node_modules and .git — several hundred MB —
# before a single instruction runs.
.git
.gitignore
node_modules
dist
.env
.env.*
!.env.example
*.log
npm-debug.log*
.DS_Store
.vscode
.idea
.claude
Dockerfile
.dockerignore
Jenkinsfile
README.md
